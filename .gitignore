# Local dev configuration and credentials (see .env.example)
.env

# `make run-local` runtime state: API pid/log, the dev operator token file (sha256 only) and the
# markers telling stop-local what run-local started.
.local/

# Authorized lab runtime state (G0.4c): throwaway CA, generated certificates, run evidence
# under deploy/lab/.run/ - generated by make lab-up, removed by make lab-down.
deploy/lab/.run/

# Python test/tooling caches
__pycache__/
*.pyc

# uv environment and tool caches
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# codegen staging trees (removed on exit; here only if codegen crashed)
.codegen-stage-*/

# python build output
/dist/
