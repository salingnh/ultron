# Test-only image: the spike's own probe/broker code on a pinned python base.
# It exists so the sandbox tests need no host bind mount (SELinux-safe) and so
# the job container carries exactly the code under test.
FROM docker.io/library/python@sha256:c5ba3deef00c7758561a0f03c26f44f10589263d40e732b8748e0d1f38f6dd89
COPY aegis_g02 /opt/g02/aegis_g02
ENV PYTHONPATH=/opt/g02
WORKDIR /tmp
