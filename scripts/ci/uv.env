# The uv release the Python gate installs for itself (scripts/ci/install-uv.sh). The runner host's
# uv and python are not used: this release downloads the interpreter .python-version pins, so bump
# uv here when it cannot yet provide a new pin.
#
# SHA-256 of uv-x86_64-unknown-linux-gnu.tar.gz, as published with the release (0.13.10,
# 2026-11-24). Changing either line is a deliberate dependency update.
AEGIS_UV_VERSION=0.13.10
AEGIS_UV_SHA256=bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c
