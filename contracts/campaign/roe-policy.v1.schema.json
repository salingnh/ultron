{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/campaign/roe-policy.v1.schema.json",
  "title": "Quy tắc tham chiến (RoE) v1",
  "description": "Do người vận hành khai báo. M01 lưu thành bản chụp bất biến có policy_version. Không có allowlist phạm vi (chốt 13/11).",
  "type": "object",
  "required": ["scan_profile", "max_parallel_jobs", "max_duration_hours"],
  "additionalProperties": false,
  "properties": {
    "scan_profile": {"$ref": "#/$defs/ScanProfile"},
    "max_impact_tier": {
      "description": "Tầng tác động cao nhất được phép. Mặc định theo scan_profile (passive=T0, low-impact=T1, standard=T2). MVP không vượt T2.",
      "type": "string", "enum": ["T0", "T1", "T2"]
    },
    "max_parallel_jobs": {"type": "integer", "minimum": 1, "maximum": 50},
    "max_duration_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_second_per_host": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "packets_per_second": {"description": "Trần cho quét cổng (Naabu, Nmap).", "type": "integer", "minimum": 1, "maximum": 100000},
        "jobs_per_minute": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "allowed_windows": {
      "description": "Tùy chọn. Rỗng hoặc vắng = được quét mọi lúc.",
      "type": "array", "items": {"$ref": "#/$defs/TimeWindow"}, "maxItems": 50
    },
    "blackout_windows": {
      "description": "Tùy chọn. Nếu có thì fail-closed: job chủ động trong khung giờ này bị từ chối với WAIT_WINDOW.",
      "type": "array", "items": {"$ref": "#/$defs/TimeWindow"}, "maxItems": 50
    },
    "approval_required_tiers": {
      "description": "Tùy chọn (mặc định rỗng). Tầng tác động cần người duyệt trước khi chạy.",
      "type": "array", "items": {"type": "string", "enum": ["T1", "T2"]}, "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_llm_cost_usd": {"type": "number", "minimum": 0},
        "max_llm_tokens": {"type": "integer", "minimum": 0},
        "max_jobs": {"type": "integer", "minimum": 1},
        "max_agent_sessions": {"type": "integer", "minimum": 1},
        "idle_cycles_before_pause": {"description": "Số chu kỳ liên tiếp không có bằng chứng mới hữu ích trước khi giảm cấp hoặc tạm dừng (đặc tả: 3 đến 5).", "type": "integer", "minimum": 3, "maximum": 5, "default": 3}
      }
    },
    "capability_denylist": {
      "description": "Tùy chọn: capability không được dùng trong chiến dịch này.",
      "type": "array", "items": {"$ref": "../common/ids.v1.schema.json#/$defs/CapabilityId"}, "uniqueItems": true
    }
  },
  "$defs": {
    "ScanProfile": {"type": "string", "enum": ["passive", "low-impact", "standard"]},
    "TimeWindow": {
      "type": "object",
      "required": ["days", "start", "end", "timezone"],
      "additionalProperties": false,
      "properties": {
        "days": {"type": "array", "items": {"type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "minItems": 1, "uniqueItems": true},
        "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$"},
        "timezone": {"description": "Tên IANA, vd Asia/Ho_Chi_Minh.", "type": "string", "minLength": 1}
      }
    }
  }
}
