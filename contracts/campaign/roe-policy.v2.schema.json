{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/campaign/roe-policy.v2.schema.json",
  "title": "Campaign execution settings v2",
  "description": "Cấu hình chạy có phiên bản: ngân sách, tốc độ, concurrency và danh sách mục tiêu bị loại. Không dùng phân loại thao tác. Khung giờ cho phép (allowed/blackout windows) đã bị bỏ khỏi contract theo quyết định chủ 2026-11-24 (G1 chỉ cần luồng chạy được); snapshot cũ còn khung giờ là lịch sử, không được chạy.",
  "type": "object",
  "required": [
    "max_parallel_jobs",
    "max_duration_hours"
  ],
  "additionalProperties": false,
  "properties": {
    "target_denylist": {
      "description": "Danh sách mục tiêu bị loại bổ sung. Sandbox luôn cách ly hạ tầng điều khiển/dữ liệu; kiểm tra cấu hình này áp dụng cho mọi job.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 10000
    },
    "max_parallel_jobs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "max_duration_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_second_per_host": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "packets_per_second": {
          "description": "Trần cho quét cổng (Naabu, Nmap).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "jobs_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_llm_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_llm_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "max_agent_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "idle_cycles_before_pause": {
          "description": "Số chu kỳ liên tiếp không có bằng chứng mới hữu ích trước khi tạm dừng kèm lý do.",
          "type": "integer",
          "minimum": 3,
          "maximum": 5,
          "default": 3
        }
      }
    },
    "capability_denylist": {
      "description": "Tùy chọn: capability không được dùng trong chiến dịch này.",
      "type": "array",
      "items": {
        "$ref": "../common/ids.v2.schema.json#/$defs/CapabilityId"
      },
      "uniqueItems": true
    }
  },
  "$defs": {}
}
