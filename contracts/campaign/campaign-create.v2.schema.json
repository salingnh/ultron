{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/campaign/campaign-create.v2.schema.json",
  "title": "Yêu cầu tạo chiến dịch v2",
  "description": "Body của POST /api/v2/campaigns. Bắt buộc header Idempotency-Key. Body KHÔNG mang actor: server gán created_by/requested_by từ principal đã xác minh (C05, X-8).",
  "type": "object",
  "required": [
    "name",
    "targets",
    "policy",
    "objective"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "targets": {
      "$ref": "#/$defs/Targets"
    },
    "policy": {
      "$ref": "roe-policy.v2.schema.json"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      },
      "maxProperties": 20
    }
  },
  "$defs": {
    "Targets": {
      "description": "Các loại seed hiện hỗ trợ; ít nhất một danh sách không rỗng. Loại input khác chỉ được thêm khi có contract tương ứng. `images` (G2-D) là digest do người vận hành cung cấp cho một campaign phân tích artifact: không crawl registry, không suy ra tag/repository từ digest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "format": "aegis-domain-seed"
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "ips": {
          "description": "IP hoặc CIDR.",
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/IPOrCIDR"
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "images": {
          "description": "Digest OCI của image được phép phân tích (operator cung cấp; M06 chỉ lấy image đã có trong local store, không pull).",
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/ImageDigest"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "required": [
            "domains"
          ],
          "properties": {
            "domains": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "ips"
          ],
          "properties": {
            "ips": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "urls"
          ],
          "properties": {
            "urls": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "emails"
          ],
          "properties": {
            "emails": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "keywords"
          ],
          "properties": {
            "keywords": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "images"
          ],
          "properties": {
            "images": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
