{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/campaign/campaign-create.v1.schema.json",
  "title": "Yêu cầu tạo chiến dịch v1",
  "description": "Body của POST /api/v1/campaigns. Bắt buộc header Idempotency-Key.",
  "type": "object",
  "required": ["name", "targets", "policy", "objective", "actor"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "targets": {"$ref": "#/$defs/Targets"},
    "policy": {"$ref": "roe-policy.v1.schema.json"},
    "actor": {"$ref": "../common/ids.v1.schema.json#/$defs/Actor"},
    "labels": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 200}, "maxProperties": 20}
  },
  "$defs": {
    "Targets": {
      "description": "Năm loại đầu vào GĐ1-GĐ2. Ít nhất một mục. GĐ3 thêm repos, cloud_accounts, clusters bằng schema v2.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 253}, "maxItems": 10000, "uniqueItems": true},
        "ips": {"description": "IP hoặc CIDR.", "type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 64}, "maxItems": 10000, "uniqueItems": true},
        "urls": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2048}, "maxItems": 10000, "uniqueItems": true},
        "emails": {"type": "array", "items": {"type": "string", "format": "email", "maxLength": 320}, "maxItems": 10000, "uniqueItems": true},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 200}, "maxItems": 1000, "uniqueItems": true}
      },
      "anyOf": [
        {"required": ["domains"], "properties": {"domains": {"minItems": 1}}},
        {"required": ["ips"], "properties": {"ips": {"minItems": 1}}},
        {"required": ["urls"], "properties": {"urls": {"minItems": 1}}},
        {"required": ["emails"], "properties": {"emails": {"minItems": 1}}},
        {"required": ["keywords"], "properties": {"keywords": {"minItems": 1}}}
      ]
    }
  }
}
