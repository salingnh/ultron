{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/ingestion/result-envelope.v2.schema.json",
  "title": "ResultEnvelope v2",
  "description": "Phong bì kết quả duy nhất cho mọi provider. Collector của M06 dựng envelope từ output đã parse và gửi POST /api/v2/ingestion/results. Bằng chứng thô nằm ở object store S3 (SeaweedFS); envelope chỉ mang tham chiếu và checksum. Mọi tham chiếu tài sản bên trong dùng canonical_key, không dùng asset_id (adapter không biết asset_id).",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "dedup_key",
    "job_id",
    "campaign_id",
    "scope_id",
    "capability",
    "provider",
    "policy_version",
    "status",
    "coverage",
    "results",
    "evidence",
    "errors",
    "provenance",
    "trace"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "description": "ID của lần nộp này, UUIDv7 sinh ở phía collector. Mỗi lần nộp một giá trị mới; KHÔNG dùng làm khóa idempotent (dùng dedup_key).",
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "dedup_key": {
      "description": "Khóa idempotent xác định từ job_id (vd 'job:<job_id>:envelope'), tái tạo được khi retry. Cùng dedup_key cùng payload trả kết quả cũ; khác payload trả 409.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "job_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "campaign_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "scope_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "capability": {
      "$ref": "../common/ids.v2.schema.json#/$defs/CapabilityId"
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "version",
        "adapter_version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "description": "Phiên bản upstream.",
          "type": "string"
        },
        "adapter_version": {
          "$ref": "../common/ids.v2.schema.json#/$defs/SemVer"
        },
        "image_digest": {
          "$ref": "../common/ids.v2.schema.json#/$defs/ImageDigest"
        }
      }
    },
    "policy_version": {
      "$ref": "../common/ids.v2.schema.json#/$defs/PolicyVersion"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "coverage": {
      "description": "Những gì job đã thực sự kiểm, theo asset (canonical_key): seed chưa thành asset không nằm ở đây mà ở provenance.seed_targets. M20 dùng để ghi FindingRun seen=false cho finding đang mở trên subject đã kiểm mà lần này không thấy. Thiếu coverage = không kết luận vắng mặt.",
      "type": "object",
      "required": [
        "subjects"
      ],
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
          },
          "maxItems": 100000
        },
        "rule_set": {
          "description": "Định danh bộ luật/mẫu đã chạy (vd nuclei-templates@<sha>, trivy-db@<date>).",
          "type": "string"
        },
        "complete": {
          "description": "false nếu job dừng giữa chừng; khi đó không ghi seen=false.",
          "type": "boolean"
        }
      }
    },
    "results": {
      "type": "object",
      "required": [
        "assets",
        "observations",
        "relationships",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "maxItems": 100000
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 500000
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "maxItems": 500000
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingCandidate"
          },
          "maxItems": 100000
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 10000
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "../common/error.v2.schema.json"
      },
      "maxItems": 1000
    },
    "provenance": {
      "type": "object",
      "required": [
        "input_fingerprint",
        "started_at",
        "finished_at",
        "seed_targets"
      ],
      "additionalProperties": false,
      "properties": {
        "input_fingerprint": {
          "description": "sha256 của input đã chuẩn hóa (canonical JSON).",
          "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
        },
        "started_at": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        },
        "seed_targets": {
          "description": "Mục tiêu đầu vào của job (G5) dưới dạng TargetRef: collector chép nguyên danh sách targets của ApprovedTask, gồm seed_id cho keyword/CIDR/seed chưa thành asset. Mọi asset mới mặc định discovered_from các tham chiếu này nếu adapter không ghi rõ hơn. M27 từ chối seed không thuộc campaign/scope của job.",
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/TargetRef"
          },
          "minItems": 1
        },
        "parent_job_id": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Id"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "trace": {
      "$ref": "../common/ids.v2.schema.json#/$defs/TraceContext"
    }
  },
  "$defs": {
    "Asset": {
      "type": "object",
      "required": [
        "kind",
        "canonical_key"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "../common/ids.v2.schema.json#/$defs/AssetKind"
        },
        "canonical_key": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
        },
        "aliases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "namespace": {
                "type": "string",
                "enum": [
                  "original",
                  "idna",
                  "oci_tag",
                  "git_branch",
                  "git_tag",
                  "hostname",
                  "cpe",
                  "other"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 2048
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "discovered_from": {
          "description": "Khóa của tài sản/mục tiêu dẫn tới tài sản này (G5).",
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
          },
          "maxItems": 50
        },
        "attributes": {
          "description": "Thuộc tính định danh theo kind (port, transport, purl version, digest...). Thuộc tính thay đổi theo thời gian phải là observation.",
          "type": "object",
          "maxProperties": 50
        },
        "confidence": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Confidence"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/EvidenceRef"
          }
        }
      }
    },
    "Observation": {
      "type": "object",
      "required": [
        "subject",
        "predicate",
        "value",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
        },
        "predicate": {
          "description": "Phải có trong contracts/ingestion/predicates.v2.yaml (cổng G4).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "value": {
          "description": "Giá trị theo value_type của predicate.",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "polarity": {
          "description": "present = thấy; absent = không thấy tại thời điểm quan sát; negated = có bằng chứng phủ định rõ ràng.",
          "type": "string",
          "enum": [
            "present",
            "absent",
            "negated"
          ],
          "default": "present"
        },
        "observed_at": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        },
        "confidence": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Confidence"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/EvidenceRef"
          }
        }
      }
    },
    "Relationship": {
      "type": "object",
      "required": [
        "type",
        "from",
        "to",
        "observed_at",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/RelationshipType"
        },
        "from": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
        },
        "to": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
        },
        "observed_at": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        },
        "confidence": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Confidence"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 20
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/EvidenceRef"
          }
        }
      }
    },
    "RelationshipType": {
      "description": "Cạnh adapter được phép gửi. HAS_FINDING, SUPPORTED_BY, DERIVED_FROM, AFFECTED_BY do lõi sinh, adapter không gửi.",
      "type": "string",
      "enum": [
        "SUBDOMAIN_OF",
        "RESOLVES_TO",
        "EXPOSES",
        "SERVES",
        "HAS_ENDPOINT",
        "HAS_ARTIFACT",
        "CONTAINS_PACKAGE",
        "DISCOVERED_FROM",
        "SNAPSHOT_OF",
        "ALIAS_OF"
      ]
    },
    "FindingCandidate": {
      "description": "Finding ứng viên từ scanner. M20 tính fingerprint, khử trùng và quyết định trạng thái; adapter không đặt status hay severity cuối.",
      "type": "object",
      "required": [
        "subject",
        "rule_id",
        "title",
        "evidence_refs",
        "fingerprint_context"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CanonicalKey"
        },
        "rule_id": {
          "description": "Định danh luật ổn định: cve:CVE-2024-1234, nuclei:<template-id>, gitleaks:<rule>, opengrep:<rule>...",
          "type": "string",
          "pattern": "^[a-z0-9_-]+:.+$",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": [
            "vulnerability",
            "misconfiguration",
            "exposure",
            "secret",
            "weak_crypto",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "description": "Dữ liệu không tin cậy.",
          "type": "string",
          "maxLength": 20000
        },
        "location": {
          "description": "Vị trí trên subject: path, line, URL, port, package...",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 4096
            },
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "line": {
              "type": "integer",
              "minimum": 0
            },
            "package_purl": {
              "type": "string",
              "pattern": "^pkg:"
            },
            "installed_version": {
              "type": "string"
            },
            "fixed_version": {
              "type": "string"
            },
            "parameter": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "vulnerability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA(-[23456789cfghjmpqrvwx]{4}){3}|[A-Z]+-[A-Za-z0-9._:-]+)$"
          },
          "uniqueItems": true
        },
        "cwe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          },
          "uniqueItems": true
        },
        "scanner_severity": {
          "description": "Mức do scanner báo, chỉ là tín hiệu đầu vào cho agent đánh giá.",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "secret": {
          "description": "Chỉ cho category=secret. Lưu dạng rõ (chốt 13/11). Cấu hình xác minh được khai báo trong input của tool.",
          "type": "object",
          "required": [
            "value",
            "fingerprint"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 20000
            },
            "fingerprint": {
              "description": "sha256 của value đã chuẩn hóa.",
              "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
            },
            "detector": {
              "type": "string"
            }
          }
        },
        "fingerprint_context": {
          "description": "Ngữ cảnh bằng chứng đã chuẩn hóa để M20 tính fingerprint ổn định qua phiên bản scanner (không chứa timestamp, ID riêng của scanner).",
          "type": "object",
          "maxProperties": 20
        },
        "confidence": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Confidence"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/EvidenceRef"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "secret"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "required": [
              "secret"
            ]
          }
        }
      ]
    },
    "Evidence": {
      "type": "object",
      "required": [
        "local_ref",
        "sha256",
        "uri",
        "size_bytes",
        "media_type",
        "classification"
      ],
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "sha256": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
        },
        "uri": {
          "description": "s3://evidence/{campaign_id}/{job_id}/{sha256}",
          "type": "string",
          "pattern": "^s3://evidence/[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "maxLength": 200
        },
        "classification": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Classification"
        },
        "kind": {
          "type": "string",
          "enum": [
            "raw_output",
            "http_exchange",
            "screenshot",
            "sbom",
            "artifact",
            "log_excerpt",
            "other"
          ]
        }
      }
    }
  }
}
