{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/events/job.started.v2.schema.json",
  "title": "Payload job.started.v2",
  "description": "Bên phát: M06. Khóa khử trùng của consumer: job_id.",
  "type": "object",
  "required": [
    "job_id",
    "campaign_id",
    "capability",
    "provider",
    "provider_version",
    "policy_version",
    "scope_id",
    "started_at",
    "attempt",
    "generation"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "Attempt của lần chạy đã phát sự kiện; consumer bỏ qua/cách ly callback của attempt cũ."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Generation của job khi phát sự kiện (fencing)."
    },
    "campaign_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "capability": {
      "$ref": "../common/ids.v2.schema.json#/$defs/CapabilityId"
    },
    "provider": {
      "type": "string"
    },
    "provider_version": {
      "type": "string"
    },
    "policy_version": {
      "$ref": "../common/ids.v2.schema.json#/$defs/PolicyVersion"
    },
    "scope_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "started_at": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
    }
  }
}
