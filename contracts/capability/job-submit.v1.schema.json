{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capability/job-submit.v1.schema.json",
  "title": "Yêu cầu gửi job v1",
  "description": "Body của POST /api/v1/jobs: người vận hành (UI) hoặc dịch vụ nội bộ gửi job thủ công. Vẫn đi qua điểm kiểm M05 như lời gọi MCP; không có đường tắt tới M06.",
  "type": "object",
  "required": ["campaign_id", "capability", "input", "rationale", "actor"],
  "additionalProperties": false,
  "properties": {
    "campaign_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "capability": {"$ref": "../common/ids.v1.schema.json#/$defs/CapabilityId"},
    "provider": {"description": "Tùy chọn: ép provider cụ thể (vd đối chứng Grype).", "type": "string"},
    "input": {"type": "object"},
    "profile": {"$ref": "../campaign/roe-policy.v1.schema.json#/$defs/ScanProfile"},
    "rationale": {"type": "string", "minLength": 3, "maxLength": 2000},
    "actor": {"$ref": "../common/ids.v1.schema.json#/$defs/Actor"}
  }
}
