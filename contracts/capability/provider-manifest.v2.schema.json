{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capability/provider-manifest.v2.schema.json",
  "title": "CapabilityProvider manifest v2",
  "description": "File adapters/<module>/<tool>/manifest.yaml. M05 Registry đọc thư mục adapters/ khi khởi động. Thêm công cụ = thêm manifest + parser, không sửa mã lõi.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "aegis.io/v2"
    },
    "kind": {
      "const": "CapabilityProvider"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "module",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Tên provider duy nhất, vd subfinder.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "version": {
          "description": "Phiên bản adapter.",
          "$ref": "../common/ids.v2.schema.json#/$defs/SemVer"
        },
        "module": {
          "$ref": "../common/ids.v2.schema.json#/$defs/ModuleCode"
        },
        "license": {
          "description": "SPDX của công cụ upstream.",
          "type": "string",
          "minLength": 1
        },
        "licenseNotes": {
          "type": "string"
        },
        "upstream": {
          "type": "string",
          "format": "uri"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "capability",
        "providerVersion",
        "runtime",
        "inputSchemaRef",
        "outputSchemaRef",
        "permissions",
        "budget",
        "handlers",
        "parser",
        "compatibilityTests"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "../common/ids.v2.schema.json#/$defs/CapabilityId"
        },
        "providerVersion": {
          "description": "Phiên bản upstream đã pin (theo docs/pinning.md).",
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "Một tool invocation chạy trong container sandbox.",
              "type": "string",
              "enum": [
                "container"
              ]
            },
            "image": {
              "description": "Tên image trong registry nội bộ, chỉ để hiển thị; định danh là imageDigest.",
              "type": "string"
            },
            "imageDigest": {
              "$ref": "../common/ids.v2.schema.json#/$defs/ImageDigest"
            },
            "argsTemplate": {
              "description": "Mảng tham số cố định; chỉ được chèn trường đã khai báo trong input schema bằng ${input.<field>}. Không có shell.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputPath": {
              "description": "Thư mục kết quả trong container.",
              "type": "string",
              "default": "/out"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "container"
                  }
                }
              },
              "then": {
                "required": [
                  "imageDigest",
                  "argsTemplate"
                ]
              }
            }
          ]
        },
        "inputSchemaRef": {
          "description": "schema://<nhóm>/<tên>/v<n> ánh xạ tới contracts/capabilities/<nhóm>/<tên>.v<n>.schema.json.",
          "type": "string",
          "pattern": "^schema://[a-z0-9-]+/[a-z0-9-]+/v[0-9]+$"
        },
        "outputSchemaRef": {
          "const": "schema://common/result-envelope/v2"
        },
        "acceptsTargetKinds": {
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/AssetKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "type": "object",
          "required": [
            "networkAccess"
          ],
          "additionalProperties": false,
          "description": "Quyền thực thi của provider. Egress chỉ đi qua broker L7 của nền tảng (kết quả G0.2): provider khai đích nó cần, nền tảng giữ tập luôn chặn. Tập luôn chặn (loopback, link-local/metadata, multicast, unspecified, mạng control/data, target_denylist của campaign) là hằng của nền tảng, không phải dữ liệu provider: permissions không có trường nào để khai báo hay nới nó, và additionalProperties=false khiến trường như vậy bị từ chối.",
          "properties": {
            "scopeRequired": {
              "const": false
            },
            "networkAccess": {
              "type": "string",
              "enum": [
                "none",
                "egress"
              ]
            },
            "egressMode": {
              "description": "Chế độ egress: GĐ1 chỉ có `broker` — container chỉ tới được broker của job; broker phân giải ở control plane, kiểm toàn bộ địa chỉ A/AAAA, pin đích đã kiểm và từ chối với mã lý do ổn định. Chế độ khác (vd L3 router cho raw socket) phải có nghiệm thu cưỡng chế trước khi thêm vào enum.",
              "type": "string",
              "enum": [
                "broker"
              ],
              "default": "broker"
            },
            "proxyAware": {
              "description": "Bắt buộc true khi egress: công cụ phải đọc HTTPS_PROXY/ALL_PROXY hoặc có tham số proxy riêng. Broker là đường ra duy nhất nên công cụ không tôn trọng proxy sẽ không kết nối được gì; M05 từ chối đăng ký provider như vậy.",
              "const": true
            },
            "egressSources": {
              "description": "Đích ngoài mục tiêu mà provider cần (nguồn dữ liệu thụ động, resolver, API). Bắt buộc khai báo khi egress, kể cả rỗng; rỗng chỉ hợp lệ khi targetBinding=required. Host là tên chính xác, không wildcard/khớp hậu tố. Binding của một job là hợp của tập này với mục tiêu đã phân giải.",
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/EgressSource"
              }
            },
            "targetBinding": {
              "description": "required: M05 phân giải mục tiêu của job thành tập IP/port đã kiểm và broker chỉ mở tới tập đó. none: provider không kết nối tới mục tiêu của job (chỉ tới egressSources), nên binding của job rỗng.",
              "type": "string",
              "enum": [
                "required",
                "none"
              ]
            },
            "targetPorts": {
              "description": "from_input: port hợp lệ của mục tiêu lấy từ input schema đã pin, không lấy từ output tool hay danh sách port của provider. Chỉ có khi targetBinding=required; cấm khi none vì không có kết nối tới mục tiêu.",
              "const": "from_input"
            },
            "rawSocket": {
              "description": "GĐ1 không có chế độ egress L3 nên raw socket không dùng được: ghim false. G0.2 đo được Naabu tự hạ SYN xuống CONNECT trong rootless Podman dù có NET_RAW, nên rawSocket=true phải kèm kiểm chế độ quét thực tế và chế độ egress L3 — đó là version sau, không phải cờ bật ở đây.",
              "const": false,
              "default": false
            },
            "credentials": {
              "description": "Tên credential gray-box chỉ đọc được cấp ngắn hạn (GĐ3). Không bao giờ là secret tìm được.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "description": "Không mạng thì không có cấu hình egress.",
              "if": {
                "required": [
                  "networkAccess"
                ],
                "properties": {
                  "networkAccess": {
                    "const": "none"
                  }
                }
              },
              "then": {
                "properties": {
                  "egressMode": false,
                  "proxyAware": false,
                  "egressSources": false,
                  "targetBinding": false,
                  "targetPorts": false
                }
              }
            },
            {
              "description": "Egress phải khai đủ chế độ, proxy, nguồn và binding.",
              "if": {
                "required": [
                  "networkAccess"
                ],
                "properties": {
                  "networkAccess": {
                    "const": "egress"
                  }
                }
              },
              "then": {
                "required": [
                  "egressMode",
                  "proxyAware",
                  "egressSources",
                  "targetBinding"
                ]
              }
            },
            {
              "description": "Egress không có đích nào bị từ chối: không nối tới mục tiêu thì phải khai ít nhất một nguồn.",
              "if": {
                "required": [
                  "networkAccess",
                  "targetBinding"
                ],
                "properties": {
                  "networkAccess": {
                    "const": "egress"
                  },
                  "targetBinding": {
                    "const": "none"
                  }
                }
              },
              "then": {
                "required": [
                  "egressSources"
                ],
                "properties": {
                  "egressSources": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "description": "Binding mục tiêu bắt buộc đi kèm khai báo port lấy từ input.",
              "if": {
                "required": [
                  "targetBinding"
                ],
                "properties": {
                  "targetBinding": {
                    "const": "required"
                  }
                }
              },
              "then": {
                "required": [
                  "targetPorts"
                ]
              }
            },
            {
              "description": "Không nối tới mục tiêu thì không khai port mục tiêu.",
              "if": {
                "required": [
                  "targetBinding"
                ],
                "properties": {
                  "targetBinding": {
                    "const": "none"
                  }
                }
              },
              "then": {
                "properties": {
                  "targetPorts": false
                }
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "required": [
            "timeoutSeconds",
            "maxConcurrency",
            "cpu",
            "memoryMb"
          ],
          "additionalProperties": false,
          "properties": {
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 86400
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16
            },
            "memoryMb": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536
            },
            "maxOutputMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10240,
              "default": 256,
              "description": "MiB (1 MiB = 1048576 byte); M06 luôn truyền trần này vào ContainerSpec, mặc định 256 MiB."
            }
          }
        },
        "handlers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "describe",
              "validate",
              "start",
              "status",
              "cancel",
              "collect",
              "health"
            ]
          },
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7
        },
        "parser": {
          "type": "object",
          "required": [
            "entrypoint",
            "outputFormat"
          ],
          "additionalProperties": false,
          "properties": {
            "entrypoint": {
              "description": "Đường dẫn module parser trong repo, vd adapters.m08.subfinder.parser:parse. Chỉ cho import dưới gói adapters.*.",
              "type": "string",
              "pattern": "^adapters\\.[a-z0-9_]+(\\.[a-z0-9_]+)+:[a-z_][a-z0-9_]*$"
            },
            "outputFormat": {
              "type": "string",
              "enum": [
                "jsonl",
                "json",
                "sarif",
                "cyclonedx",
                "spdx",
                "xml",
                "text"
              ]
            }
          }
        },
        "emits": {
          "description": "Loại dữ liệu adapter có thể sinh, để Registry kiểm conformance.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assetKinds": {
              "type": "array",
              "items": {
                "$ref": "../common/ids.v2.schema.json#/$defs/AssetKind"
              }
            },
            "predicates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "boolean"
            }
          }
        },
        "compatibilityTests": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "schema",
              "policy",
              "cancellation",
              "idempotency",
              "fixture-replay",
              "network-isolation"
            ]
          },
          "uniqueItems": true,
          "contains": {
            "const": "fixture-replay"
          }
        },
        "inputDefaults": {
          "type": "object",
          "description": "Giá trị mặc định cho input. Sau khi ghép phải kiểm bằng inputSchemaRef; không nhận tham số ngoài schema."
        }
      }
    }
  },
  "$defs": {
    "EgressSource": {
      "description": "Một đích egress ngoài mục tiêu. Chỉ khai được cái nền tảng cưỡng chế được: host tĩnh, port tĩnh, giao thức broker L7 hiểu. UDP/ICMP và wildcard không biểu diễn được vì GĐ1 không có egress L3.",
      "type": "object",
      "required": [
        "id",
        "hosts",
        "ports",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Mã ổn định cho audit và quyết định policy; không phải tên miền.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "purpose": {
          "type": "string",
          "maxLength": 200
        },
        "hosts": {
          "description": "Host chính xác: tên DNS đã chuẩn hóa hoặc IP literal. Không wildcard, không khớp hậu tố; broker từ chối cả tên nếu một đáp án phân giải nằm ngoài binding.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "../common/ids.v2.schema.json#/$defs/DomainTarget",
                "pattern": "^(?!dns:)"
              },
              {
                "$ref": "../common/ids.v2.schema.json#/$defs/IPAddress"
              }
            ]
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "protocol": {
          "description": "https/http: L7 HTTP (absolute-URI/CONNECT). tls/tcp: tunnel TCP thô trên port khai báo. dns: DNS over TCP qua broker. Broker GĐ1 không relay UDP.",
          "type": "string",
          "enum": [
            "https",
            "http",
            "tls",
            "tcp",
            "dns"
          ]
        }
      }
    }
  }
}
