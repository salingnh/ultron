{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capability/job.v1.schema.json",
  "title": "ScanJob v1 (đọc)",
  "description": "Response của GET /api/v1/jobs/{id} và POST /api/v1/jobs.",
  "type": "object",
  "required": ["job_id", "campaign_id", "capability", "provider", "status", "job_fingerprint", "policy_version", "scope_id", "created_at"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "campaign_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "capability": {"$ref": "../common/ids.v1.schema.json#/$defs/CapabilityId"},
    "provider": {"type": "string"},
    "provider_version": {"type": "string"},
    "status": {"$ref": "#/$defs/JobStatus"},
    "job_fingerprint": {"$ref": "../common/ids.v1.schema.json#/$defs/Sha256"},
    "scan_cycle": {"description": "Định danh lần quét (D21), thành phần của job_fingerprint.", "$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "policy_version": {"$ref": "../common/ids.v1.schema.json#/$defs/PolicyVersion"},
    "scope_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "targets": {"type": "array", "items": {"$ref": "../common/ids.v1.schema.json#/$defs/CanonicalKey"}},
    "impact_tier": {"$ref": "../common/ids.v1.schema.json#/$defs/ImpactTier"},
    "requested_by": {"$ref": "../common/ids.v1.schema.json#/$defs/Actor"},
    "rationale": {"type": "string"},
    "created_at": {"$ref": "../common/ids.v1.schema.json#/$defs/Timestamp"},
    "started_at": {"$ref": "../common/ids.v1.schema.json#/$defs/Timestamp"},
    "finished_at": {"$ref": "../common/ids.v1.schema.json#/$defs/Timestamp"},
    "envelope_event_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "evidence_ids": {"type": "array", "items": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"}},
    "error": {"$ref": "../common/error.v1.schema.json"}
  },
  "$defs": {
    "JobStatus": {"type": "string", "enum": ["QUEUED", "VALIDATING", "DISPATCHED", "RUNNING", "COLLECTING", "SUCCEEDED", "FAILED", "CANCELLED"]}
  }
}
