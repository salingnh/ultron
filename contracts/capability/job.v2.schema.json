{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capability/job.v2.schema.json",
  "title": "ScanJob v2 (đọc)",
  "description": "Response của GET /api/v2/jobs/{id} và POST /api/v2/jobs.",
  "type": "object",
  "required": [
    "job_id",
    "campaign_id",
    "capability",
    "provider",
    "status",
    "job_fingerprint",
    "policy_version",
    "scope_id",
    "created_at",
    "priority",
    "depends_on",
    "requested_by",
    "adapter_version",
    "manifest_sha256",
    "attempt",
    "generation"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "campaign_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "capability": {
      "$ref": "../common/ids.v2.schema.json#/$defs/CapabilityId"
    },
    "provider": {
      "type": "string"
    },
    "provider_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Số lần dispatch trong cùng generation. M06 tăng 1 mỗi lần dispatch lại job chưa terminal (vd mất container); callback mang attempt cũ bị cách ly. Re-execution sau terminal là generation mới, không phải attempt mới."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Thế hệ tái thực thi của job: 1 khi tạo, +1 chỉ khi mở lại job đã terminal (attempt trở về 1, kết quả cũ đã xoá khỏi hàng). Khác scan_cycle (lần quét mới là job mới) và khác retry truyền lại envelope."
    },
    "cancel": {
      "$ref": "#/$defs/CancelIntent"
    },
    "wait_reason": {
      "$ref": "#/$defs/WaitReason"
    },
    "job_fingerprint": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
    },
    "scan_cycle": {
      "description": "Định danh lần quét, thành phần của job_fingerprint.",
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "policy_version": {
      "$ref": "../common/ids.v2.schema.json#/$defs/PolicyVersion"
    },
    "scope_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "targets": {
      "description": "Mục tiêu đã phân giải của job (TargetRef: seed_id hoặc canonical_key). Giữ nguyên seed gốc của campaign; đây là nguồn của G5/provenance, không phải allowlist.",
      "type": "array",
      "items": {
        "$ref": "../common/ids.v2.schema.json#/$defs/TargetRef"
      }
    },
    "requested_by": {
      "description": "Người/kênh khởi động job, server gán (operator|module). Hàng lịch sử trước 0010 có thể giữ actor tự khai cũ (kể cả kind=agent): chỉ đọc, không dispatch/replay, không diễn giải lại.",
      "oneOf": [
        {
          "$ref": "../common/ids.v2.schema.json#/$defs/RequestedBy"
        },
        {
          "$ref": "#/$defs/LegacyRequestedBy"
        }
      ]
    },
    "proposed_by": {
      "description": "Phiên agent đã đề xuất job (session_id), server gán; vắng mặt khi người vận hành/module gửi trực tiếp hoặc hàng lịch sử trước 0010.",
      "$ref": "../common/ids.v2.schema.json#/$defs/ProposedBy"
    },
    "rationale": {
      "type": "string"
    },
    "created_at": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
    },
    "started_at": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
    },
    "finished_at": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
    },
    "envelope_event_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/ids.v2.schema.json#/$defs/Id"
      }
    },
    "error": {
      "$ref": "../common/error.v2.schema.json"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Số lớn chạy trước trong tập job đã đủ dependency; không thay thế kiểm tra điều kiện thực thi."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "../common/ids.v2.schema.json#/$defs/Id"
      },
      "uniqueItems": true,
      "maxItems": 100,
      "default": [],
      "description": "Job tiền nhiệm trong cùng campaign, phải SUCCEEDED trước dispatch. M05 từ chối self-reference và chu trình."
    },
    "adapter_version": {
      "$ref": "../common/ids.v2.schema.json#/$defs/SemVer"
    },
    "manifest_sha256": {
      "description": "Pin manifest của job mới; null chỉ cho job lịch sử chưa chuyển đổi, không được dispatch/replay.",
      "anyOf": [
        {
          "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "LegacyRequestedBy": {
      "description": "Actor tự khai của hàng job trước 0010 (thường là chính phiên agent). Chỉ đọc: hàng này không có pin/proposed_by và không được dispatch/replay; không chuyển ngược thành RequestedBy hay gán một operator thay thế.",
      "allOf": [
        {
          "$ref": "../common/ids.v2.schema.json#/$defs/Actor"
        }
      ],
      "properties": {
        "kind": {
          "const": "agent"
        }
      }
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "QUEUED",
        "VALIDATING",
        "DISPATCHED",
        "RUNNING",
        "COLLECTING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "CancelIntent": {
      "description": "Ý định hủy đã ghi nhận (cancel intent). Bản thân nó không đổi trạng thái: job terminal khi M06 gọi terminal hóa. Ý định không bao giờ ghi đè một kết quả terminal đã nhận trước đó; nó vẫn nằm trong lịch sử.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "requested_by"
      ],
      "properties": {
        "requested_at": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        },
        "requested_by": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Actor"
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "WaitReason": {
      "description": "Lý do job đang chờ (X-4). Chỉ có khi status=QUEUED; job QUEUED không có wait_reason là job sẵn sàng dispatch. Dependency thất bại/hủy làm job chờ, không tự bỏ dependency.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "since"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "DEPENDENCY_PENDING",
            "DEPENDENCY_FAILED",
            "CAMPAIGN_PAUSED",
            "BUDGET_EXHAUSTED",
            "WINDOW_CLOSED",
            "CONCURRENCY_LIMIT",
            "RATE_LIMITED",
            "PROVIDER_UNAVAILABLE",
            "MANUAL_HOLD"
          ]
        },
        "detail": {
          "description": "Giải thích cho người vận hành; dữ liệu không tin cậy khi lấy từ tool.",
          "type": "string",
          "maxLength": 500
        },
        "blocking_job_ids": {
          "description": "Job tiền nhiệm đang chặn (cùng campaign) khi code là DEPENDENCY_*.",
          "type": "array",
          "items": {
            "$ref": "../common/ids.v2.schema.json#/$defs/Id"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "since": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Timestamp"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "wait_reason chỉ có nghĩa khi job đang chờ dispatch.",
      "if": {
        "required": [
          "wait_reason"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "QUEUED"
          }
        }
      }
    },
    {
      "description": "Trạng thái terminal phải có finished_at.",
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "finished_at"
        ]
      }
    },
    {
      "description": "CANCELLED chỉ xảy ra sau một cancel intent (cancel ghi intent trước, terminal sau).",
      "if": {
        "properties": {
          "status": {
            "const": "CANCELLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "cancel"
        ]
      }
    }
  ]
}
