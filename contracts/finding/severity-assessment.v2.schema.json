{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/finding/severity-assessment.v2.schema.json",
  "title": "Đánh giá mức nghiêm trọng v2",
  "description": "Đánh giá mức nghiêm trọng do agent, không dùng công thức trọng số. Mỗi lần đánh giá lại là bản ghi mới. LLM sinh severity/reasons/uncertainty/recommended_actions; mã gán assessed_by và inputs. Output không hợp lệ ghi OUTPUT_INVALID, giữ lịch sử bất biến; không tự dùng severity cũ như kết quả mới. Hình dạng fallback khi chưa có assessment hoặc source_refs hợp lệ còn phải khóa ở S1.4 (contracts/interfaces/README.md), không tạo nguồn giả để vượt schema.",
  "type": "object",
  "required": [
    "severity",
    "reasons",
    "source_refs",
    "uncertainty",
    "recommended_actions",
    "assessed_by",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "source_refs": {
      "description": "Mỗi lý do phải dẫn được về evidence hoặc bản ghi intel.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "evidence",
              "intel",
              "observation",
              "finding_run"
            ]
          },
          "ref": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "inputs": {
      "description": "Ảnh chụp tín hiệu tại lúc đánh giá để tái lập được.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cvss": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "vector": {
              "type": "string"
            },
            "base_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "kev": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "listed": {
              "type": "boolean"
            },
            "date_added": {
              "type": "string"
            },
            "catalog_version": {
              "type": "string"
            }
          }
        },
        "epss": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "date": {
              "type": "string"
            }
          }
        },
        "exposure": {
          "type": "string",
          "enum": [
            "internet",
            "internal",
            "unknown"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "scanner_severity": {
          "type": "string"
        },
        "poc_reference_available": {
          "type": "boolean"
        },
        "intel_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessed_by": {
      "description": "Nguồn đánh giá do mã gán; agent ghi model trực tiếp, không phân nhóm model.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "rule",
            "operator"
          ]
        },
        "session_id": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Id"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "actor": {
          "description": "Bắt buộc khi kind=operator.",
          "$ref": "../common/ids.v2.schema.json#/$defs/Actor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          },
          "then": {
            "required": [
              "session_id",
              "model",
              "prompt_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "operator"
              }
            }
          },
          "then": {
            "required": [
              "actor"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "Severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO",
        "UNRATED"
      ]
    }
  }
}
