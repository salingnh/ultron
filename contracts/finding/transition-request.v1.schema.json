{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/finding/transition-request.v1.schema.json",
  "title": "Yêu cầu chuyển trạng thái finding v1",
  "description": "Body của POST /api/v1/findings/{id}/transitions. Kiểm theo transitions.v1.yaml. expected_seq chống ghi đè đồng thời (khác seq hiện tại → 409).",
  "type": "object",
  "required": ["to", "reason", "actor", "expected_seq"],
  "additionalProperties": false,
  "properties": {
    "to": {"$ref": "finding-status.v1.schema.json"},
    "reason": {"type": "string", "minLength": 3, "maxLength": 4000},
    "evidence_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "actor": {"$ref": "../common/ids.v1.schema.json#/$defs/Actor"},
    "expected_seq": {"type": "integer", "minimum": 0}
  }
}
