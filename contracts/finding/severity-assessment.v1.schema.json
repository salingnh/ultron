{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/finding/severity-assessment.v1.schema.json",
  "title": "Đánh giá mức nghiêm trọng v1",
  "description": "Do agent đánh giá (chốt 13/11), không có công thức trọng số. Mỗi lần đánh giá lại là một bản ghi mới. Output LLM phải hợp lệ theo schema này, nếu không M20 giữ mức cũ và ghi lỗi OUTPUT_INVALID.",
  "type": "object",
  "required": ["severity", "reasons", "source_refs", "uncertainty", "recommended_actions", "assessed_by", "inputs"],
  "additionalProperties": false,
  "properties": {
    "severity": {"$ref": "#/$defs/Severity"},
    "reasons": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "minItems": 1, "maxItems": 20},
    "source_refs": {
      "description": "Mỗi lý do phải dẫn được về evidence hoặc bản ghi intel.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["kind", "ref"], "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["evidence", "intel", "observation", "finding_run"]},
          "ref": {"type": "string", "maxLength": 500}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 20},
    "recommended_actions": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 20},
    "inputs": {
      "description": "Ảnh chụp tín hiệu tại lúc đánh giá để tái lập được.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "cvss": {"type": ["object", "null"], "properties": {"version": {"type": "string"}, "vector": {"type": "string"}, "base_score": {"type": "number", "minimum": 0, "maximum": 10}}},
        "kev": {"type": ["object", "null"], "properties": {"listed": {"type": "boolean"}, "date_added": {"type": "string"}, "catalog_version": {"type": "string"}}},
        "epss": {"type": ["object", "null"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}, "percentile": {"type": "number", "minimum": 0, "maximum": 1}, "date": {"type": "string"}}},
        "exposure": {"type": "string", "enum": ["internet", "internal", "unknown"]},
        "criticality": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
        "scanner_severity": {"type": "string"},
        "poc_reference_available": {"type": "boolean"},
        "intel_snapshot_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assessed_by": {
      "type": "object", "required": ["session_id", "model", "profile"], "additionalProperties": false,
      "properties": {
        "session_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
        "model": {"type": "string"},
        "profile": {"type": "string", "enum": ["LOW", "MID", "HIGH"]},
        "prompt_version": {"type": "string"}
      }
    }
  },
  "$defs": {
    "Severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNRATED"]}
  }
}
