{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capabilities/network/discover-services.v2.schema.json",
  "title": "network.discover_services v2",
  "description": "Nhận diện dịch vụ trên cổng đã biết mở. Không chạy script NSE nhóm intrusive/exploit/brute/dos.",
  "type": "object",
  "required": [
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "concurrency": {
      "description": "Số kết nối quét song song (`-c`). Đặt bằng trần `rate_limits.max_concurrent_connections_per_host` của RoE; trần cứng là `budget.maxConcurrency` của manifest đã pin. Broker vẫn xếp hàng/quá hạn theo trần RoE khi công cụ vượt.",
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "packets_per_second": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "targets": {
      "description": "Khóa service:<ip>:<port>/<transport> hoặc ip:<ip> kèm ports.",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../../common/ids.v2.schema.json#/$defs/CanonicalKey"
          },
          {
            "pattern": "^(service|ip):"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "version_intensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "default": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": {
            "contains": {
              "type": "string",
              "pattern": "^ip:"
            }
          }
        }
      },
      "then": {
        "required": [
          "ports"
        ],
        "properties": {
          "ports": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
