{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/capabilities/dns/resolve.v2.schema.json",
  "title": "dns.resolve v2",
  "type": "object",
  "required": [
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "../../common/ids.v2.schema.json#/$defs/DomainTarget"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "record_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A",
          "AAAA",
          "CNAME",
          "MX",
          "NS",
          "TXT",
          "PTR",
          "SOA",
          "CAA"
        ]
      },
      "uniqueItems": true,
      "default": [
        "A",
        "AAAA",
        "CNAME"
      ]
    },
    "resolvers": {
      "type": "array",
      "items": {
        "$ref": "../../common/ids.v2.schema.json#/$defs/IPAddress"
      },
      "maxItems": 10
    }
  }
}
