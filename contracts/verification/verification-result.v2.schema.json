{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/verification/verification-result.v2.schema.json",
  "title": "Kết quả thô của lần xác minh v2",
  "description": "Tài liệu kết quả của provider xác minh (nuclei-verify cho L1/C1, config-verify cho E1), lưu nguyên làm bằng chứng và được M21 parse lại bằng cùng đoạn mã để quyết định. Tài liệu chỉ ghi cái đã thấy: request/response, trạng thái, băm body, token trích ra và các giá trị cấu trúc của TLS/header/listing; KHÔNG có giá trị kỳ vọng, canary hay ngưỡng quyết định — M21 giữ các giá trị đó phía server và so sánh. errors rỗng nghĩa là provider không báo lỗi; một target không trả lời vẫn là một mục với answered=false, không bị bỏ im lặng.",
  "type": "object",
  "required": [
    "schema_version",
    "check_id",
    "check_pack_sha256",
    "tool",
    "targets",
    "requests_sent",
    "request_cap",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "check_id": {
      "description": "ID check đã chạy (enum của verification-request.v2/registry).",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "check_pack_sha256": {
      "description": "Băm pack đã mount khi chạy; khớp với hàng verification_run và ApprovedTask.",
      "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version",
        "image_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "image_digest": {
          "$ref": "../common/ids.v2.schema.json#/$defs/ImageDigest"
        }
      }
    },
    "targets": {
      "description": "Mỗi vai một mục: positive, patched_twin, benign. Một target không trả lời có answered=false và requests rỗng, để M21 thấy nó chứ không coi im lặng là âm tính.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/TargetResult"
      }
    },
    "requests_sent": {
      "type": "integer",
      "minimum": 0
    },
    "request_cap": {
      "type": "integer",
      "minimum": 1
    },
    "errors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/ToolError"
      }
    }
  },
  "$defs": {
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "Observation": {
      "description": "Giá trị cấu trúc đã thấy. Chỉ các trường oracle của M21 dùng; không có giá trị kỳ vọng. Với TLS, subject/issuer là chuỗi RFC 4514 đã chuẩn hóa; not_after_epoch là giây Unix để so với thời điểm chạy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "server": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "x_powered_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "product": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "listing": {
          "description": "Trang trả về là một directory listing.",
          "type": "boolean"
        },
        "files": {
          "description": "Tên tệp trong listing; M21 so băm tên với canary, không so giá trị kỳ vọng trong tài liệu này.",
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "negotiated_version": {
          "type": "string",
          "maxLength": 32
        },
        "negotiated_cipher": {
          "type": "string",
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "maxLength": 2000
        },
        "issuer": {
          "type": "string",
          "maxLength": 2000
        },
        "not_before": {
          "type": "string",
          "maxLength": 100
        },
        "not_after": {
          "type": "string",
          "maxLength": 100
        },
        "not_after_epoch": {
          "type": "number"
        },
        "expired": {
          "type": "boolean"
        },
        "self_signed": {
          "type": "boolean"
        },
        "certificate_sha256": {
          "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
        },
        "accepted_versions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/TlsVersion"
          }
        },
        "attempts": {
          "description": "Kết quả từng lần bắt tay theo phiên bản TLS (vd 'accepted', 'refused: SSLError').",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "RequestResult": {
      "type": "object",
      "required": [
        "path",
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Đường dẫn HTTP đã gửi, hoặc nhãn của phép thử không phải HTTP (vd 'tls:1.0', 'certificate').",
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "description": "Mã trạng thái HTTP; null khi phép thử không có response HTTP (bắt tay TLS, đọc chứng chỉ).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "body_sha256": {
          "description": "Băm body đã nhận; null khi không có body.",
          "anyOf": [
            {
              "$ref": "../common/ids.v2.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "description": "Chuỗi trích ra từ response (vd canary); M21 băm và so với giá trị kỳ vọng của lần chạy.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "TargetResult": {
      "type": "object",
      "required": [
        "role",
        "address",
        "port",
        "answered",
        "requests"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "positive",
            "patched_twin",
            "benign"
          ]
        },
        "address": {
          "$ref": "../common/ids.v2.schema.json#/$defs/IPAddress"
        },
        "port": {
          "$ref": "#/$defs/Port"
        },
        "answered": {
          "description": "Target có trả lời ít nhất một request/handshake không; false là một kết quả, không phải lỗi bị bỏ qua.",
          "type": "boolean"
        },
        "requests": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/RequestResult"
          }
        },
        "observed": {
          "description": "Giá trị cấu trúc của target (E1); vắng với check chỉ đọc HTTP thô.",
          "$ref": "#/$defs/Observation"
        }
      }
    },
    "TlsVersion": {
      "type": "string",
      "enum": [
        "TLSv1",
        "TLSv1.1",
        "TLSv1.2",
        "TLSv1.3"
      ]
    },
    "ToolError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "../common/error.v2.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
