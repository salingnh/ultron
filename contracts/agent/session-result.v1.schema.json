{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/agent/session-result.v1.schema.json",
  "title": "AgentSessionResult v1",
  "description": "Kết quả trả về của Activity run_agent_session (M03 → M02). Đề xuất job đã được gửi qua công cụ MCP trong phiên (M05 quyết định); ở đây chỉ còn ID để workflow chờ. Nếu spike 1/4 chọn cách workflow tự dispatch thì dùng trường proposals thay cho requested_jobs.",
  "type": "object",
  "required": ["session_id", "decision", "steps_used", "requested_jobs", "denied", "hypothesis_updates", "usage"],
  "additionalProperties": false,
  "properties": {
    "session_id": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"},
    "decision": {"type": "string", "enum": ["continue", "wait", "stop"]},
    "stop_reason": {"type": "string", "enum": ["objective_met", "no_new_evidence", "budget_exhausted", "step_limit", "blocked", "operator"]},
    "steps_used": {"type": "integer", "minimum": 0, "maximum": 30},
    "requested_jobs": {"type": "array", "items": {"$ref": "../common/ids.v1.schema.json#/$defs/Id"}},
    "denied": {"type": "array", "items": {"type": "object", "required": ["capability", "code"], "properties": {"capability": {"type": "string"}, "code": {"$ref": "../common/error.v1.schema.json#/$defs/ErrorCode"}}}},
    "proposals": {"type": "array", "items": {"$ref": "../mcp/capability-request.v1.schema.json"}},
    "hypothesis_updates": {"type": "array", "items": {"$ref": "hypothesis-update.v1.schema.json"}},
    "summary": {"type": "string", "maxLength": 4000},
    "usage": {
      "type": "object", "required": ["input_tokens", "output_tokens", "cost_usd"], "additionalProperties": false,
      "properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "cost_usd": {"type": "number"}, "models": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
