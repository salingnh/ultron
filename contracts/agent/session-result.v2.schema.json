{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.io/contracts/agent/session-result.v2.schema.json",
  "title": "AgentSessionResult v2",
  "description": "Kết quả Activity run_agent_session (M03 → M02). Agent đã gửi job qua MCP/M05 trong phiên; requested_jobs chỉ chứa ID để workflow chờ. M02 không dispatch lại danh sách đề xuất từ kết quả phiên.",
  "type": "object",
  "required": [
    "session_id",
    "decision",
    "steps_used",
    "requested_jobs",
    "denied",
    "hypothesis_updates",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "$ref": "../common/ids.v2.schema.json#/$defs/Id"
    },
    "decision": {
      "type": "string",
      "enum": [
        "continue",
        "wait",
        "stop"
      ]
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "objective_met",
        "no_new_evidence",
        "budget_exhausted",
        "step_limit",
        "blocked",
        "operator"
      ]
    },
    "steps_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "requested_jobs": {
      "type": "array",
      "items": {
        "$ref": "../common/ids.v2.schema.json#/$defs/Id"
      }
    },
    "denied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "code"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "code": {
            "$ref": "../common/error.v2.schema.json#/$defs/ErrorCode"
          }
        }
      }
    },
    "hypothesis_updates": {
      "type": "array",
      "items": {
        "$ref": "hypothesis-update.v2.schema.json"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
