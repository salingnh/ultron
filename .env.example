# Cấu hình local của checkout này. File này KHÔNG được commit (git-ignored, mode 600).
#
# `make dev-up` / `make run-local` chép file này thành `.env` ở lần chạy đầu, và mọi script trong
# scripts/ đọc `.env`. Đây là nơi DUY NHẤT chứa bí mật: key model, key upstream của LLM gateway,
# đường dẫn token. Vì vậy `.env` phải mode 600 - `make llm-gateway-up` từ chối một `.env` mà
# group/other đọc được. Đừng commit `.env` và đừng chép key sang file khác trong repo.
#
# Pin image không nằm ở đây (deploy/*/images.env) và luôn thắng `.env`.
# Cổng dùng offset 1xxxx để không đụng PostgreSQL / Neo4j / S3 / Temporal khác đang chạy.

# --- Stack và cổng ----------------------------------------------------------
# Một stack thuộc về checkout đã tạo nó. Muốn stack riêng bên cạnh stack của người khác trên cùng
# một máy: bỏ comment hai tên dưới đây và đặt cổng trống cho mọi cổng được publish.
# AEGIS_DEV_PROJECT=aegis-dev-worker-b
# AEGIS_LAB_PROJECT=aegis-lab-worker-b

# PostgreSQL: user / mật khẩu / database / cổng host.
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis-dev-pg
AEGIS_PG_DB=aegis
AEGIS_PG_PORT=15432

# Neo4j: mật khẩu, hai cổng host (HTTP, bolt), heap và page cache của JVM.
AEGIS_NEO4J_PASSWORD=aegis-dev-neo4j
AEGIS_NEO4J_HTTP_PORT=17474
AEGIS_NEO4J_BOLT_PORT=17687
AEGIS_NEO4J_HEAP=512m
AEGIS_NEO4J_PAGECACHE=256m

# SeaweedFS S3 (raw/evidence). Bucket được tạo kèm Object Lock bởi `make dev-up`.
AEGIS_S3_PORT=18333
AEGIS_SEAWEEDFS_FILER_PORT=18888
AEGIS_S3_BUCKET=aegis-raw

# Temporal (persistence dùng PostgreSQL ở trên).
AEGIS_TEMPORAL_PORT=17233

# --- Lab --------------------------------------------------------------------
# Override file runner-profile của zone lab: `make run-local` tự export path chuẩn
# (deploy/lab/runner-profile.json); chỉ đặt ở đây khi dùng file khác. Path tuyệt đối.
AEGIS_M06_LAB_PROFILE=

# --- LLM: model thật qua gateway của bạn ------------------------------------
# Mặc định ultron chạy policy scripted (demo/CI), không gọi model nào. Bật LLM thật qua gateway
# (deploy/llm-gateway) trong 5 bước:
#   1. Đặt AEGIS_SESSION_LIVE_MODEL=1 và AEGIS_MODEL_GATEWAY=1 bên dưới, điền
#      AEGIS_MODEL_BASE_URL=http://127.0.0.1:4000/v1 và AEGIS_MODEL_NAME=<group trong config.yaml>.
#   2. Chép deploy/llm-gateway/config.example.yaml vào ~/.config/ultron/llm-gateway/config.yaml và
#      khai endpoint + thứ tự ưu tiên ở đó (chỉ endpoint, không cần key).
#   3. Thêm key upstream vào chính file này: LLM_KEY_A=..., LLM_KEY_B=... - đúng những tên mà
#      config.yaml tham chiếu (os.environ/LLM_KEY_A).
#   4. make llm-gateway-up   (tự sinh AEGIS_MODEL_API_KEY vào .env nếu còn trống, mode 600).
#   5. make llm-smoke        (một lời gọi thật, chỉ chạy tay; không bao giờ trong CI).
# Xoay vòng endpoint nằm ở gateway, không ở app: AEGIS_MODEL_GATEWAY=1 từ chối fallback trong M04.
# Nội dung request/response không bao giờ bị log; metadata (model, endpoint, status, token, chi phí,
# độ trễ) nằm ở aegis.model_usage và /metrics của proxy.

# 0/unset = policy scripted, 1 = model thật (giá trị khác là lỗi, không có trạng thái thứ ba).
AEGIS_SESSION_LIVE_MODEL=0
# 1 = base URL bên dưới là gateway của bạn: bắt buộc có base URL, và app không tự fallback nữa.
AEGIS_MODEL_GATEWAY=0
# openai = mọi endpoint OpenAI-compatible, anthropic = endpoint Anthropic.
AEGIS_MODEL_PROVIDER=openai
# Tên nhóm định tuyến trong config.yaml (không phải tên model upstream).
AEGIS_MODEL_NAME=
# Bỏ trống = endpoint chính thức của provider; qua gateway thì trỏ vào loopback của gateway.
AEGIS_MODEL_BASE_URL=
# Key model, và cũng là master key của gateway (một key cho cả hai phía).
# Bỏ trống: make llm-gateway-up tự sinh và ghi vào file này, không in ra.
AEGIS_MODEL_API_KEY=
# Giá USD trên 1 triệu token, chỉ dùng khi gateway không báo chi phí (endpoint không khai giá).
AEGIS_MODEL_PRICE_INPUT_PER_MTOK=
AEGIS_MODEL_PRICE_OUTPUT_PER_MTOK=
# Timeout một lời gọi và trần token trả về.
AEGIS_MODEL_TIMEOUT_SECONDS=120
AEGIS_MODEL_MAX_OUTPUT_TOKENS=2048

# Key upstream của gateway: một dòng mỗi endpoint, tên phải khớp os.environ/<TÊN> trong
# ~/.config/ultron/llm-gateway/config.yaml. Không commit, không dán vào issue/log.
# LLM_KEY_A=
# LLM_KEY_B=
# LLM_KEY_C=

# --- Internet và egress (M06) -----------------------------------------------
# Override file runner-profile internet: `make run-local` tự export path chuẩn
# (deploy/internet/runner-profile.json); chỉ đặt khi dùng file khác.
AEGIS_M06_INTERNET_PROFILE=
# Image broker đã pin digest: trống = dùng pin trong repo (`make run-local` export giúp).
AEGIS_M06_BROKER_IMAGE=
# Network ra internet của broker (phải có gateway): trống = network của profile internet.
AEGIS_UPLINK_NETWORK=
# OCI hook do deployment sở hữu, cấp default route cho job `egressMode: l3` (broker làm gateway).
# Trống = mọi job L3 bị từ chối.
AEGIS_L3_HOOK=
# Đường dẫn provider-config.yaml của Subfinder (key nằm trong file đó, không nằm ở đây).
# Trống = Subfinder chỉ dùng các nguồn không cần key.
AEGIS_SUBFINDER_PROVIDER_CONFIG=

# --- Intel (M18) ------------------------------------------------------------
# File chứa NVD API key (mode 0600). Chỉ ghi PATH, không bao giờ ghi key.
# Trống = giới hạn công khai của NVD (5 request / 30 s).
AEGIS_NVD_API_KEY_FILE=
# File cấu hình nguồn KEV của deployment; mặc định deploy/intel/kev-source.json.
AEGIS_KEV_SOURCE_FILE=
# File chứa GitHub token (mode 0600) để nâng rate limit khi lấy KEV. Chỉ ghi PATH.
AEGIS_GITHUB_TOKEN_FILE=
# Nguồn EPSS (URL hoặc path tới CSV đã gunzip) và ngày score.
# Trống = bước EPSS được báo là skipped, không bao giờ coi là mới.
AEGIS_EPSS_SOURCE=
AEGIS_EPSS_VERSION=
