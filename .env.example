# Local development configuration for the G0.4a dev stack (deploy/dev/compose.yaml).
#
# `make dev-up` copies this file to .env on first run (.env is git-ignored) and every
# scripts/dev/*.sh script reads it. Values below are local-only defaults for a stack bound
# to 127.0.0.1; they are not credentials for any shared system. Never commit a real
# credential here - put it in .env instead.
#
# Ports use a 1xxxx offset so the dev stack never collides with another local PostgreSQL,
# Neo4j, S3 or Temporal an operator already runs on the default ports. Change them in .env
# when a port is taken; make dev-up reports which one and stops before starting anything.
#
# Image pins are not listed here: they live in deploy/dev/images.env and win over .env.
#
# Several checkouts on one host: a stack belongs to the checkout that created it. To run your own
# isolated stack beside another one, set the two project names below and a free port for every
# published port (PostgreSQL, Neo4j x2, S3, the filer and Temporal). `make dev-up` / `make lab-up`
# refuse to touch a project created from another checkout, and a second lab also needs a different
# `AEGIS_LAB_PROJECT` (its network is <project>-lab; the lab subnet is fixed, so its own project
# needs the previous lab removed first).
# AEGIS_DEV_PROJECT=aegis-dev-worker-b
# AEGIS_LAB_PROJECT=aegis-lab-worker-b

# PostgreSQL metadata store
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis-dev-pg
AEGIS_PG_DB=aegis
AEGIS_PG_PORT=15432

# Neo4j graph projection
AEGIS_NEO4J_PASSWORD=aegis-dev-neo4j
AEGIS_NEO4J_HTTP_PORT=17474
AEGIS_NEO4J_BOLT_PORT=17687
AEGIS_NEO4J_HEAP=512m
AEGIS_NEO4J_PAGECACHE=256m

# SeaweedFS S3 (raw/evidence store); bucket is created with Object Lock by make dev-up
AEGIS_S3_PORT=18333
AEGIS_SEAWEEDFS_FILER_PORT=18888
AEGIS_S3_BUCKET=aegis-raw

# Temporal
AEGIS_TEMPORAL_PORT=17233

# Agent model (G1.6). Unset or 0 = the scripted policy the demo and CI use; 1 = a live provider
# built from the settings below. Every line is commented out: `make dev-up` copies this file to
# .env (git-ignored) on first run, and `make run-local` / `make llm-smoke` read that file, so a new
# checkout keeps the scripted policy until an operator fills the names in. A live deployment without
# a key, a price or a provider stops at start-up instead of guessing. Prices are USD per million
# tokens, from the provider's own price list for the chosen model.
# AEGIS_SESSION_LIVE_MODEL=1
# AEGIS_MODEL_PROVIDER=openai          # openai (any OpenAI-compatible base URL) or anthropic
# AEGIS_MODEL_NAME=
# AEGIS_MODEL_BASE_URL=               # optional; defaults to the provider's official endpoint
# AEGIS_MODEL_API_KEY=
# AEGIS_MODEL_PRICE_INPUT_PER_MTOK=
# AEGIS_MODEL_PRICE_OUTPUT_PER_MTOK=
# AEGIS_MODEL_TIMEOUT_SECONDS=120
# AEGIS_MODEL_MAX_OUTPUT_TOKENS=2048
#
# Through the owner's LLM gateway (G1.6): `make llm-gateway-up` runs it, `AEGIS_MODEL_BASE_URL`
# points at it and `AEGIS_MODEL_GATEWAY=1` says so. The gateway owns rotation between endpoints, so
# M04 runs one attempt and records the per-request cost the gateway reports (the price below is the
# fallback for an answer the gateway did not price). AEGIS_MODEL_NAME is the gateway's model group,
# not an upstream model id; AEGIS_MODEL_API_KEY is the gateway's master key.
# AEGIS_MODEL_GATEWAY=1
# AEGIS_MODEL_BASE_URL=http://127.0.0.1:4000/v1
# AEGIS_MODEL_NAME=aegis-smart
# AEGIS_MODEL_API_KEY=                 # = LITELLM_MASTER_KEY in ~/.config/ultron/llm-gateway/secrets.env

# M06 network profiles (G1.6). A campaign's RoE names the profile its jobs run on; these files say
# which network and endpoint data this deployment has for it. The lab profile is the authorized
# DNS lab; the internet profile's `network` is the broker's uplink (a network with a gateway).
# Leave them unset to run only the profile you configure explicitly.
AEGIS_M06_LAB_PROFILE=
AEGIS_M06_INTERNET_PROFILE=
AEGIS_M06_BROKER_IMAGE=
# The broker's outbound leg: a dedicated network a deployment owns (run-local creates
# `aegis-uplink`). Empty = the internet profile's own `network` value.
AEGIS_UPLINK_NETWORK=
# Deployment-owned OCI hook that gives an `egressMode: l3` job its only default route (the broker
# as gateway). Its contract is fixed: it is never named by a task. Empty = L3 jobs are refused.
AEGIS_L3_HOOK=

# Subfinder provider config for the internet profile: the *path* of a provider-config.yaml that is
# mounted read-only into the job (passive sources' API keys live inside that file). Only the name
# is listed here - never put a key value in .env.example, a commit, a task payload or a log line.
# Unset = Subfinder runs with the keyless sources the manifest declares.
AEGIS_SUBFINDER_PROVIDER_CONFIG=
