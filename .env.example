# Local development configuration for the G0.4a dev stack (deploy/dev/compose.yaml).
#
# `make dev-up` copies this file to .env on first run (.env is git-ignored) and every
# scripts/dev/*.sh script reads it. Values below are local-only defaults for a stack bound
# to 127.0.0.1; they are not credentials for any shared system. Never commit a real
# credential here - put it in .env instead.
#
# Ports use a 1xxxx offset so the dev stack never collides with another local PostgreSQL,
# Neo4j, S3 or Temporal an operator already runs on the default ports. Change them in .env
# when a port is taken; make dev-up reports which one and stops before starting anything.
#
# Image pins are not listed here: they live in deploy/dev/images.env and win over .env.

# PostgreSQL metadata store
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis-dev-pg
AEGIS_PG_DB=aegis
AEGIS_PG_PORT=15432

# Neo4j graph projection
AEGIS_NEO4J_PASSWORD=aegis-dev-neo4j
AEGIS_NEO4J_HTTP_PORT=17474
AEGIS_NEO4J_BOLT_PORT=17687
AEGIS_NEO4J_HEAP=512m
AEGIS_NEO4J_PAGECACHE=256m

# SeaweedFS S3 (raw/evidence store); bucket is created with Object Lock by make dev-up
AEGIS_S3_PORT=18333
AEGIS_SEAWEEDFS_FILER_PORT=18888
AEGIS_S3_BUCKET=aegis-raw

# Temporal
AEGIS_TEMPORAL_PORT=17233
