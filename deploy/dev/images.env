# Pinned images for the dev environment (G0.4a) and CI (G0.4b).
#
# Every image is pinned by registry manifest-list digest; the human-readable tag stays for
# reviewers. `make dev-up`, `make dev-down` and the CI scripts source this file, so there is
# exactly one place to bump a version. Values are the digest returned by
# `docker.io` (registry-1.docker.io) for the tag on the date below; changing a line here is a
# deliberate dependency update, not a routine edit.
#
#   image                     tag                    digest (manifest list)                            image created
#   postgres                  18 (18.7)              2026-11-24
#   neo4j                     5.26.34-community       2026-11-24
#   seaweedfs                 4.55                   2026-11-23
#   temporalio/server         1.32.2                 2026-10-31
#   temporalio/admin-tools    1.32.2                 2026-11-03   (schema and namespace; same release)
#   python                    3.14.10-slim-trixie    2026-11-24   (CI contract tests only)

AEGIS_PG_IMAGE=docker.io/library/postgres:18@sha256:64c8b0d31e4ab6ea665e8426ea406a94bf52de3c05b3a4a8bf713704eefa9328
AEGIS_NEO4J_IMAGE=docker.io/library/neo4j:5.26.34-community@sha256:2c48628bc28c68d7e2787f76262dfc9d7c21a8f7f290e30da901c489aa7fe50d
AEGIS_SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.55@sha256:7ca46aeae2f223b37e5d91593c17ab37738eec6df6ab69b48a0487f7643342b9
AEGIS_TEMPORAL_IMAGE=docker.io/temporalio/server:1.32.2@sha256:7bf69188a6232fea14869b9cef3d94aa82a1601d99517f7e86c71f22da4e0670
AEGIS_TEMPORAL_ADMIN_TOOLS_IMAGE=docker.io/temporalio/admin-tools:1.32.2@sha256:4a95866efba29d7e17ab012df5232795e8b0ad0f7d5f9d1ec4df321f7792a754
AEGIS_PYTHON_IMAGE=docker.io/library/python:3.14.10-slim-trixie@sha256:22eafb370920ad8b429e0aec3fff433e0669968519f5d60469d83729c138b28b
