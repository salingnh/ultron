# LLM gateway secrets (G1.6) - the owner's file, NOT repository state.
#
# Copy this file to /home/admin/.config/ultron/llm-gateway/secrets.env, fill in the values, and
# `chmod 600` it; `make llm-gateway-up` refuses a file any group or other user can read. Every name
# here is referenced from config.yaml as `os.environ/<NAME>`; the gateway reads the file as
# container environment, and no script here prints a value.
#
# LITELLM_MASTER_KEY is the gateway's own key: ultron sends it as AEGIS_MODEL_API_KEY, and it is
# the only credential the gateway requires. Use a long random value, for example:
#   python3 -c 'import secrets; print("sk-" + secrets.token_urlsafe(32))'
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-value

# One key per upstream endpoint. Name them after the deployment that uses them.
UPSTREAM_A_API_KEY=sk-replace-with-endpoint-a-key
UPSTREAM_B_API_KEY=sk-replace-with-endpoint-b-key
UPSTREAM_C_API_KEY=sk-ant-replace-with-endpoint-c-key
