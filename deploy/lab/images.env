# Pinned images for the authorized lab (G0.4c).
#
# Same rule as deploy/dev/images.env: every image is pinned by registry manifest-list digest;
# the tag stays for reviewers. `make lab-up`, `make lab-down` and the lab runs source this
# file, so there is one place to bump a version. dnsx and subfinder are exactly the G0.2 pins
# (`docs/living/dac-ta-ky-thuat/04-module-ket-noi-oss.md` §Chọn provider); do not bump one
# copy without the other, and re-run the parser/conformance suites when a tool pin moves.
#
#   image                     tag                    released     license
#   coredns                   1.15.0                 2026-10-21   Apache-2.0   (lab DNS, infrastructure only)
#   python                    3.12.16-slim-trixie    2026-11-05   PSF-2.0      (passive stub; same pin as deploy/dev/images.env)
#   dnsx                      v1.2.2                 2025-02-01   MIT          (G0.2 pin)
#   subfinder                 v2.17.0                2026-10-08   MIT          (G0.2 pin)
#   nginx                     1.18.0                 2020-04-21   BSD-2-Clause (G1.6a service `web-legacy`: 80/443; CVE-2021-23017)
#   tomcat                    9.0.30-jdk11-openjdk   2019-12-12   Apache-2.0   (G1.6a service: 8080/8009; CVE-2020-1938)
#   openssh-server            9.9_p2-r0              2025-04-09   BSD + GPL-3.0 (G1.6a service: 2222, no credential)
#   redis                     6.0.5-buster           2020-06-09   BSD-3-Clause (G1.6a service: 6379; CVE-2022-0543)
#   httpd                     2.4.49                 2021-09-15   Apache-2.0   (G1.6a service `legacy-httpd`: 80; CVE-2021-41773)
#   fingerprintx              v1.1.19                2026-01-01   Apache-2.0   (G1.6b service.fingerprint; built locally)
#   httpx                     v1.12.0                2026-09-08   MIT          (G1.6b web.probe_http)
#
# The four G1.6a service images are deliberately old releases with public CVEs: the lab is where
# the discovery chain proves it can see a port, a service and (later) a version that a CVE snapshot
# can match. They are targets to observe, not applications to serve, and they publish no port.

AEGIS_LAB_DNS_IMAGE=docker.io/coredns/coredns:1.15.0@sha256:0a9d8c8ddf34347eb59aad9a8784f0710de88d6d112726d11d271f9bc6daca26
AEGIS_LAB_PASSIVE_IMAGE=docker.io/library/python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
AEGIS_LAB_DNSX_IMAGE=docker.io/projectdiscovery/dnsx:v1.2.2@sha256:8fced0bedf3655e06c9f1805f6277d60d4988a4b13209e24b3d7cde7baa656ec
AEGIS_LAB_SUBFINDER_IMAGE=docker.io/projectdiscovery/subfinder:v2.17.0@sha256:2f5ddea311db2a8b848e40f1b669fc655d0eb78b74a74ead93d3850e372b12bf
AEGIS_LAB_NAABU_IMAGE=docker.io/projectdiscovery/naabu:v2.7.0@sha256:67c120a669954b768354197fc04328e08027898dc821bc8f276b3e26cd21f6aa
AEGIS_LAB_WEB_LEGACY_IMAGE=docker.io/library/nginx:1.18.0@sha256:9b0fc8e09ae1abb0144ce57018fc1e13d23abd108540f135dc83c0ed661081cf
AEGIS_LAB_APP_IMAGE=docker.io/library/tomcat:9.0.30-jdk11-openjdk@sha256:c800cc5439845e4034bb92d36d3e294b1e252c3c7b2233760d7ba3e3fa9b9332
AEGIS_LAB_SSH_IMAGE=docker.io/linuxserver/openssh-server:version-9.9_p2-r0@sha256:0485ba3d964e48bf17ab526903d163f1ca913bccac6e2c0a61fefb2840f39840
AEGIS_LAB_CACHE_IMAGE=docker.io/library/redis:6.0.5-buster@sha256:76ff608805ca40008d6e0f08180d634732d8bf4728b85c18ab9bdbfa0911408d
AEGIS_LAB_HTTPD_IMAGE=docker.io/library/httpd:2.4.49@sha256:4b5cb7697fea2aa6d398504c381b693a54ae9ad5e6317fcdbb7a2d9b8c3b1364

# G1.6b adapters. fingerprintx publishes no image: this is the digest of the image built from
# deploy/lab/tools/fingerprintx/Dockerfile by `make lab-build-fingerprintx`. A rebuild is a pin
# bump: update this line, adapters/m08/fingerprintx/manifest.yaml and the contract copy, then
# re-record the adapter's lab fixture.
AEGIS_LAB_FINGERPRINTX_IMAGE=localhost/aegis/fingerprintx:v1.1.19@sha256:48ce97d72380bad8eaba16ec8c3e54e9225b450b146d7572a39d9f14013b54fe
AEGIS_LAB_HTTPX_IMAGE=docker.io/projectdiscovery/httpx:v1.12.0@sha256:f8275a7c6aaec187249df9eaf4ad9196f4677adfc6a51a47b4aaa1d4db4f8ffc
