# Configuration of the CVE test lab (G1.6 slice E). `make vulnlab-up` copies this file to
# deploy/vulnlab/.env on first run and never prints a value from it.
#
# The lab runs without the tunnel by default: only the `lab` profile (origin addresses on
# `aegis-lab-lab`) is used, which is what CI and the demos exercise. The tunnel is opt-in through
# AEGIS_VULNLAB_TUNNEL_TOKEN, because creating the Cloudflare tunnel, its DNS records and the
# Cloudflare Access policy is an owner decision (item 61).
#
# Never commit deploy/vulnlab/.env (git-ignored): it carries the tunnel token.

# Cloudflare Tunnel token (owner provides it). Empty means "no tunnel": the origins start on the
# lab network only and the runner's `internet` profile refuses to run.
AEGIS_VULNLAB_TUNNEL_TOKEN=

# Public hostnames of the lab, one per case. They are the names Cloudflare will publish; the
# tunnel ingress rendered from this file and `make vulnlab-test PROFILE=internet` both read them.
# Replace the `example.com` placeholders with real subdomains of the authorized domain. The origin
# port is never part of the public URL: Cloudflare terminates TLS and forwards to the origin.
AEGIS_VULNLAB_HOST_HTTPD=vuln-httpd.vulnlab.example.com
AEGIS_VULNLAB_HOST_NGINX=vuln-nginx.vulnlab.example.com
AEGIS_VULNLAB_HOST_TOMCAT=vuln-tomcat.vulnlab.example.com
AEGIS_VULNLAB_HOST_SPRING=vuln-spring.vulnlab.example.com
AEGIS_VULNLAB_HOST_JENKINS=vuln-jenkins.vulnlab.example.com
AEGIS_VULNLAB_HOST_JETTY=vuln-jetty.vulnlab.example.com
AEGIS_VULNLAB_HOST_STRUTS2=vuln-struts2.vulnlab.example.com

# Every container gets a podman `--timeout` of this many minutes when the stack is created, so the
# stack stops by itself even if nobody runs `make vulnlab-down`; 1-1440, default 120.
VULNLAB_TTL_MINUTES=120
