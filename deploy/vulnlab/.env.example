# Configuration of the CVE test lab (G1.6 slice E). `make vulnlab-up` copies this file to
# deploy/vulnlab/.env on first run and never prints a value from it.
#
# The lab runs without the tunnel by default: only the `lab` profile (origin addresses on
# `aegis-lab-lab`) is used, which is what CI and the demos exercise. Publishing the origins is an
# explicit opt-in (`VULNLAB_TUNNEL=1`, or `PROFILE=internet`), never a side effect of a token file
# that happens to exist: these services are vulnerable on purpose.
#
# Never commit deploy/vulnlab/.env (git-ignored): it names this checkout's stack and the public
# hostnames, and the tunnel token lives in a 0600 file outside the repository.

# Compose project of this checkout (default aegis-vulnlab). A stack on a shared host belongs to the
# checkout that created it, and only one vulnlab stack may exist per host because the origins use
# fixed addresses on the shared lab network. Set this when the default project belongs to another
# checkout; it must keep the aegis-vulnlab prefix.
AEGIS_VULNLAB_PROJECT=

# Publish the origins through the Cloudflare Tunnel. Off by default, even when a token file exists;
# 1/true/yes/on enables it, 0/false/no/off (or unset) keeps the lab lab-only.
VULNLAB_TUNNEL=0

# Cloudflare Tunnel token: never paste it into this file. Save the token in a 0600 file outside the
# repository and either rely on the default path or point this variable at it. `make vulnlab-up`
# refuses a file readable by group/other and never prints the value. Without a token the lab runs
# lab-only and the runner's `internet` profile refuses to run.
#   default: /home/admin/.config/ultron/vulnlab-tunnel.token (used when it exists)
AEGIS_VULNLAB_TUNNEL_TOKEN_FILE=

# Public hostnames of the lab, one per case (used only when the tunnel is enabled). They are the
# names Cloudflare publishes; the documented ingress mirror and `make vulnlab-test PROFILE=internet`
# both read them.
# Replace the `example.com` placeholders with real subdomains of the authorized domain. The origin
# port is never part of the public URL: Cloudflare terminates TLS and forwards to the origin.
AEGIS_VULNLAB_HOST_HTTPD=vuln-httpd.vulnlab.example.com
AEGIS_VULNLAB_HOST_NGINX=vuln-nginx.vulnlab.example.com
AEGIS_VULNLAB_HOST_TOMCAT=vuln-tomcat.vulnlab.example.com
AEGIS_VULNLAB_HOST_SPRING=vuln-spring.vulnlab.example.com
AEGIS_VULNLAB_HOST_JENKINS=vuln-jenkins.vulnlab.example.com
AEGIS_VULNLAB_HOST_JETTY=vuln-jetty.vulnlab.example.com
AEGIS_VULNLAB_HOST_STRUTS2=vuln-struts2.vulnlab.example.com

# Every container gets a podman `--timeout` of this many minutes when the stack is created, so the
# stack stops by itself even if nobody runs `make vulnlab-down`; 1-1440, default 120.
VULNLAB_TTL_MINUTES=120
