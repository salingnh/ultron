# Pinned images for the CVE test lab (G1.6 slice E).
#
# Same rule as deploy/dev/images.env and deploy/lab/images.env: every image is pinned by registry
# manifest-list digest (single-arch images by their manifest digest - the tag stays for reviewers),
# and the license is recorded next to it. `make vulnlab-up`, `make vulnlab-down`, `make vulnlab-check`
# and `make vulnlab-status` source this file, so there is one place to bump a version.
#
# These are deliberately old, vulnerable versions: they exist to exercise port/fingerprint/CVE
# candidate detection, not to be safe. They never run on a host port, never mount the host and
# only speak to the `aegis-vulnlab-net` network (origins) or the `aegis-lab-lab` lab network; the
# launcher arms a podman `--timeout` on every container so the whole stack stops by itself.
#
#   variable                        version   license             why
#   AEGIS_VULNLAB_HTTPD_IMAGE       2.4.49    Apache-2.0          CVE-2021-41773/42013 path traversal
#   AEGIS_VULNLAB_NGINX_IMAGE       1.16.0    BSD-2-Clause        CVE-2019-9511/9513, CVE-2021-23017
#   AEGIS_VULNLAB_TOMCAT_IMAGE      8.5.19    Apache-2.0 (vulhub MIT)  CVE-2017-12617, CVE-2020-1938
#   AEGIS_VULNLAB_SPRING_IMAGE      5.3.17    Apache-2.0 (vulhub MIT)  Spring4Shell demo, Tomcat 8.5.77
#   AEGIS_VULNLAB_JENKINS_IMAGE     2.138     MIT                 CVE-2018-1000861, CVE-2024-23897
#   AEGIS_VULNLAB_JETTY_IMAGE       9.4.40    EPL-2.0 OR Apache-2.0  CVE-2021-28169/34429, CVE-2024-8184
#   AEGIS_VULNLAB_STRUTS2_IMAGE     2.3.30    Apache-2.0 (vulhub MIT)  S2-045 demo (version not disclosed)
#   AEGIS_VULNLAB_CLOUDFLARED_IMAGE 2026.9.3  Apache-2.0          outbound-only tunnel, no published port
#   AEGIS_VULNLAB_PROBE_IMAGE       3.12.16   PSF-2.0             one-shot HTTP probe from the lab network
#
# The CVE ids each pin must produce are in tests/vulnlab/cases.yaml (with the NVD/KEV snapshot they
# were taken from); `make test` checks that every case pin here matches that catalog.

AEGIS_VULNLAB_HTTPD_IMAGE=docker.io/library/httpd:2.4.49@sha256:dcba0d12e2362fb0c50ec524ae8aa1cca4a4ba7216617a57e7bbca20767e79cc
AEGIS_VULNLAB_NGINX_IMAGE=docker.io/library/nginx:1.16.0@sha256:3e373fd5b8d41baeddc24be311c5c6929425c04cabf893b874ac09b72a798010
AEGIS_VULNLAB_TOMCAT_IMAGE=docker.io/vulhub/tomcat:8.5.19@sha256:dc424beb9f2ebc24cade77046b1ee8409f23b26faebf5fe3d1ce8b3ce1211b91
AEGIS_VULNLAB_SPRING_IMAGE=docker.io/vulhub/spring-webmvc:5.3.17@sha256:04ef9147d7c73b5853936736ca2af66bbfc2a026dc3968a7ffdba21a0b78dd07
AEGIS_VULNLAB_JENKINS_IMAGE=docker.io/jenkins/jenkins:2.138@sha256:5dd1b1ae9e1d7092382cb185b18d0db63278620c1a149012cc3c8a1078e87a8b
AEGIS_VULNLAB_JETTY_IMAGE=docker.io/library/jetty:9.4.40-jre11-slim@sha256:f47c2df4f1c3e5a4baad289652826327329f0c07c92a76b715e8722b1ad42ebe
AEGIS_VULNLAB_STRUTS2_IMAGE=docker.io/vulhub/struts2:2.3.30@sha256:b992e080d8e5ad332bf526ae26124d28f56ca4fc9e0eaa91510dbee9870eb2c8
AEGIS_VULNLAB_CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
# Same pin as deploy/lab/images.env AEGIS_LAB_PASSIVE_IMAGE: one Python image on this host, already
# used for the lab stub, so the probe adds no extra download. It runs one-shot, read-only.
AEGIS_VULNLAB_PROBE_IMAGE=docker.io/library/python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
