[Unit]
Description=GitHub Actions runner (ultron, ephemeral, label ultron-local)
Documentation=https://github.com/salingnh/ultron/blob/main/scripts/ci/install-runner.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Own directory: ~/actions-runner on a shared machine may already hold a runner for
# another repository, and a runner must never adopt another repo's registration.
ExecStart=%h/ultron-runner/run-loop.sh
Environment=ULTRON_REPO=salingnh/ultron
Environment=ULTRON_RUNNER_LABEL=ultron-local
# No secret is passed in this environment: the loop fetches a one-hour registration token
# with `gh` and every job only inherits PATH, HOME, XDG_RUNTIME_DIR and similar.
Restart=always
RestartSec=15
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=default.target
